# --- Clerk (auth) ---
# From your Clerk dashboard -> API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Postgres (SQLAlchemy + Alembic, continuum database) ---
# Plain postgresql:// scheme is fine — the app normalises it to the asyncpg driver.
# `postgres` is the docker-compose service name (see root docker-compose.yml) —
# use localhost:5432 instead if running the backend outside Docker.
DATABASE_URL=postgresql://continuum:yourpassword@postgres:5432/continuum

# --- MCP JWT minting (RS256) ---
# Private key never leaves this service. Generate as a keypair together with
# core-mcp's CONTINUUM_JWT_PUBLIC_KEY. Paste the PEM with literal \n line breaks
# or use a multi-line value depending on how you load it.
CONTINUUM_BACKEND_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----"
CONTINUUM_BACKEND_JWT_ALGORITHM=RS256

# --- Internal trust boundary with core-mcp ---
# Shared secret header value, must match core-mcp's CONTINUUM_INTERNAL_SECRET
CONTINUUM_INTERNAL_SECRET=replace-with-a-long-random-secret

# Base URL of the core-mcp service (for /internal/* proxy calls)
CONTINUUM_CORE_BASE_URL=http://localhost:8788

# --- CORS (frontend is now a separate origin — Vite SPA, no more Next.js rewrite proxy) ---
# Origin the frontend is served from — the only origin allowed to call this API.
CONTINUUM_FRONTEND_URL=http://localhost:3000
# This service's own public URL — what the frontend's VITE_BACKEND_URL should point to.
CONTINUUM_BACKEND_PUBLIC_URL=http://localhost:8789

# --- Server ---
PORT=8789
