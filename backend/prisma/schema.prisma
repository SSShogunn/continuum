datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model McpToken {
  id          String    @id @default(uuid())
  clerkUserId String
  label       String
  jti         String    @unique
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  @@index([clerkUserId])
}

model OAuthClient {
  id           String   @id @default(uuid())
  clientSecret String
  redirectUris String[]
  name         String?
  createdAt    DateTime @default(now())
}

model OAuthCode {
  code                String   @id
  clerkUserId         String
  clientId            String
  redirectUri         String
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())
}
