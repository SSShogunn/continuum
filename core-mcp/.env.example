# ── Postgres (continuum_core database) ─────────────────────────────────────────
CONTINUUM_DATABASE_URL=postgresql://user:password@localhost:5432/continuum_core

# ── Redis (ARQ background job queue) ────────────────────────────────────────────
# Points at the host machine's Redis instance (localhost doesn't reach the host
# from inside Docker — same host.docker.internal pattern as CONTINUUM_CORE_BASE_URL
# in backend/.env)
CONTINUUM_REDIS_URL=redis://:YOUR_PASSWORD@host.docker.internal:6379/0


# ── JWT verification (RS256 public key from backend keypair) ───────────────────
CONTINUUM_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nXXXXXX\n-----END PUBLIC KEY-----"
CONTINUUM_JWT_ALGORITHM=RS256

# ── Internal trust boundary with backend ───────────────────────────────────────
# Must match backend's CONTINUUM_INTERNAL_SECRET
CONTINUUM_INTERNAL_SECRET=replace-with-a-long-random-hex-secret

# ── Public URLs ────────────────────────────────────────────────────────────────
CONTINUUM_BACKEND_PUBLIC_URL=https://your-backend-domain.example.com
CONTINUUM_REDIRECT_URL=https://github.com/SSShogunn/continuum

# ── Server ─────────────────────────────────────────────────────────────────────
CONTINUUM_PORT=8788

# ── Fact/graph extraction LLM (via litellm) ─────────────────────────────────────
# Using Claude Haiku 4.5 through Amazon Bedrock Global cross-Region inference
# (ap-south-1 doesn't host the model directly — this routes through it).
# CONTINUUM_FACT_EXTRACTION_API_KEY holds a Bedrock long-term API key (Bedrock
# console → API keys → Long-term API keys → Generate) — litellm accepts it as
# a bearer token, no IAM access key/secret pair needed.
CONTINUUM_FACT_EXTRACTION_MODEL=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
CONTINUUM_FACT_EXTRACTION_API_KEY=

AWS_REGION_NAME=ap-south-1

# ── search_web (self-hosted SearXNG, see root docker-compose.yml) ──────────────
# Only needed if not using the default in-network hostname
CONTINUUM_SEARXNG_URL=http://searxng:8080

# ── extract_structured (via litellm) ────────────────────────────────────────────
# Separate model/key from fact/graph extraction above, so it can be swapped
# independently. Defaults to Groq, same provider as fact extraction.
CONTINUUM_EXTRACT_MODEL=groq/llama-3.3-70b-versatile
CONTINUUM_EXTRACT_API_KEY=

