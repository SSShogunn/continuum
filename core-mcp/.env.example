# ── Postgres (continuum_core database) ─────────────────────────────────────────
CONTINUUM_DATABASE_URL=postgresql://user:password@localhost:5432/continuum_core

# ── JWT verification (RS256 public key from backend keypair) ───────────────────
CONTINUUM_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nXXXXXX\n-----END PUBLIC KEY-----"
CONTINUUM_JWT_ALGORITHM=RS256

# ── Internal trust boundary with backend ───────────────────────────────────────
# Must match backend's CONTINUUM_INTERNAL_SECRET
CONTINUUM_INTERNAL_SECRET=replace-with-a-long-random-hex-secret

# ── Public URLs ────────────────────────────────────────────────────────────────
CONTINUUM_BACKEND_PUBLIC_URL=https://your-backend-domain.example.com
CONTINUUM_REDIRECT_URL=https://github.com/SSShogunn/continuum

# ── Server ─────────────────────────────────────────────────────────────────────
CONTINUUM_PORT=8788
