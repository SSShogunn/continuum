# ── Clerk ──────────────────────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/dashboard
VITE_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Backend (public — called cross-origin with CORS + Clerk bearer tokens) ──────
VITE_BACKEND_URL=http://localhost:8789

# ── Continuum MCP server (public — used in dashboard connect/install commands) ──
VITE_CONTINUUM_MCP_URL=https://continuum-mcp.sshogunn.org

# ── Dev server (optional) ────────────────────────────────────────────────────────
# Comma-separated hostnames the Vite dev server will accept requests for. Unset =
# unrestricted (fine for localhost/self-host); set this if you're reverse-proxying
# dev mode under your own domain and want Vite's host-header check back.
# VITE_ALLOWED_HOSTS=continuum.example.com
